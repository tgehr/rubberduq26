&lt;h2 id="dconf26"&gt;DConf'26&lt;/h2&gt;
&lt;h3 id="timon-gehr"&gt;Timon Gehr&lt;/h3&gt;
&lt;hr&gt;
&lt;h1 id="the-silq-programming-language"&gt;The Silq programming language&lt;/h1&gt;
&lt;p&gt;A high-level programming language for quantum computing.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Evolution:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;2010: Custom D compiler frontend as a hobby project&lt;/li&gt;
&lt;li&gt;2015: Forked D compiler frontend for the PSI language&lt;/li&gt;
&lt;li&gt;2018: Forked PSI to create Silq&lt;/li&gt;
&lt;/ul&gt;
&lt;hr&gt;
&lt;h1 id="silq-synopsis"&gt;Silq: Synopsis&lt;/h1&gt;
&lt;pre class="silq-code-window"&gt;&lt;code class="language-silq"&gt;def bernstein_vazirani[n:!ℕ](const f: 𝔹^n !→lifted 𝔹){
	xs := [H(0) for _ in 0..n];
	if f(xs) { phase(π); }
	return measure([H(x) for x in xs]);
}

def f(const xs:𝔹^5){
	bs := [0,1,0,1,1];
	r := 0;
	for i in 0..5{
		r ⊕= bs[i]·xs[i];
	}
	return r;
}

def main() =&amp;gt; assert(bernstein_vazirani(f) == [0,1,0,1,1]);&lt;/code&gt;&lt;/pre&gt;&lt;hr&gt;
&lt;h1 id="d-vs-silq-selection"&gt;D vs Silq (selection)&lt;/h1&gt;
&lt;table&gt;
 &lt;thead&gt;
 &lt;tr&gt;
 &lt;th&gt;Construct&lt;/th&gt;
 &lt;th style="text-align: center"&gt;D&lt;/th&gt;
 &lt;th style="text-align: center"&gt;Silq&lt;/th&gt;
 &lt;/tr&gt;
 &lt;/thead&gt;
 &lt;tbody&gt;
 &lt;tr&gt;
 &lt;td&gt;Concatenation&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;a &lt;span style="color:#ff79c6"&gt;~&lt;/span&gt; b&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;a ~ b&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Power&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;a &lt;span style="color:#ff79c6"&gt;^^&lt;/span&gt; b&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;a ^ b&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Xor&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;a &lt;span style="color:#ff79c6"&gt;^&lt;/span&gt; b&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;a xor b&lt;/code&gt;
 / &lt;code class="language-silq"&gt;a ⊻ b&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Bitwise Xor&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;a &lt;span style="color:#ff79c6"&gt;^&lt;/span&gt; b&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;a xorb b&lt;/code&gt;
 / &lt;code class="language-silq"&gt;a ⊕ b&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Declaration&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;&lt;span style="color:#8be9fd;font-style:italic"&gt;auto&lt;/span&gt; a &lt;span style="color:#ff79c6"&gt;=&lt;/span&gt; b&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;a := b&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Ternary expr.&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;c &lt;span style="color:#ff79c6"&gt;?&lt;/span&gt; a &lt;span style="color:#ff79c6"&gt;:&lt;/span&gt; b&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;if a then b else c&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;/tbody&gt;
&lt;/table&gt;
&lt;hr&gt;
&lt;h1 id="d-vs-silq-types"&gt;D vs Silq types&lt;/h1&gt;
&lt;table&gt;
 &lt;thead&gt;
 &lt;tr&gt;
 &lt;th&gt;Construct&lt;/th&gt;
 &lt;th style="text-align: center"&gt;D&lt;/th&gt;
 &lt;th style="text-align: center"&gt;Silq&lt;/th&gt;
 &lt;/tr&gt;
 &lt;/thead&gt;
 &lt;tbody&gt;
 &lt;tr&gt;
 &lt;td&gt;Boolean&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;&lt;span style="color:#8be9fd"&gt;bool&lt;/span&gt;&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;!B&lt;/code&gt;
 / &lt;code class="language-silq"&gt;!𝔹&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;8-bit unsigned integer&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;&lt;span style="color:#8be9fd"&gt;ubyte&lt;/span&gt;&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;!uint[8]&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;32-bit signed integer&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;&lt;span style="color:#8be9fd"&gt;int&lt;/span&gt;&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;!int[32]&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Tuple type&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;Tuple&lt;span style="color:#ff79c6"&gt;!(&lt;/span&gt;S&lt;span style="color:#ff79c6"&gt;,&lt;/span&gt;T&lt;span style="color:#ff79c6"&gt;,&lt;/span&gt;U&lt;span style="color:#ff79c6"&gt;)&lt;/span&gt;&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;S x T x U&lt;/code&gt;
 / &lt;code class="language-silq"&gt;S × T × U&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Fixed-length array&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;T&lt;span style="color:#ff79c6"&gt;[&lt;/span&gt;n&lt;span style="color:#ff79c6"&gt;]&lt;/span&gt;&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;T^n&lt;/code&gt;
 = &lt;code class="language-silq"&gt;T × T × ⋯ × T&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Dependent-length array&lt;/td&gt;
 &lt;td style="text-align: center"&gt;No&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;T^n&lt;/code&gt;
 (&lt;code&gt;n&lt;/code&gt; a runtime expression)&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Dynamic-length array&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;T&lt;span style="color:#ff79c6"&gt;[]&lt;/span&gt;&lt;/code&gt; (slice)&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;T[]&lt;/code&gt;
 (value type)&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Effects&lt;/td&gt;
 &lt;td style="text-align: center"&gt;e.g. &lt;code class="code-inline language-d"&gt;&lt;span style="color:#8be9fd;font-style:italic"&gt;pure&lt;/span&gt;&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;qfree&lt;/code&gt;
 / &lt;code class="language-silq"&gt;mfree&lt;/code&gt;
 / &lt;code class="language-silq"&gt;wild&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Closures&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;B &lt;span style="color:#50fa7b"&gt;delegate&lt;/span&gt;&lt;span style="color:#ff79c6"&gt;(&lt;/span&gt;A&lt;span style="color:#ff79c6"&gt;)&lt;/span&gt;&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;a -&amp;gt; b&lt;/code&gt;
 / &lt;code class="language-silq"&gt;a → b&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;Closures with effects&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="code-inline language-d"&gt;B &lt;span style="color:#50fa7b"&gt;delegate&lt;/span&gt;&lt;span style="color:#ff79c6"&gt;(&lt;/span&gt;A&lt;span style="color:#ff79c6"&gt;)&lt;/span&gt;&lt;span style="color:#8be9fd;font-style:italic"&gt;pure&lt;/span&gt;&lt;/code&gt;&lt;/td&gt;
 &lt;td style="text-align: center"&gt;&lt;code class="language-silq"&gt;A -&amp;gt;qfree B&lt;/code&gt;
 / &lt;code class="language-silq"&gt;A →qfree B&lt;/code&gt;
&lt;/td&gt;
 &lt;/tr&gt;
 &lt;/tbody&gt;
&lt;/table&gt;
&lt;hr&gt;
&lt;h1 id="nb-initialization"&gt;NB: Initialization&lt;/h1&gt;
&lt;div class="twocolumn" style="--twocolumn-left:1fr;--twocolumn-right:1fr;--twocolumn-gap:1.5rem;--twocolumn-width:100%;--twocolumn-align:start"&gt;&lt;div class="twocolumn-column"&gt;&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-d" data-lang="d"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="kt"&gt;float&lt;/span&gt; &lt;span class="n"&gt;f&lt;/span&gt;&lt;span class="o"&gt;;&lt;/span&gt; &lt;span class="c1"&gt;// initialize?
&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="c1"&gt;&lt;/span&gt;&lt;span class="k"&gt;if&lt;/span&gt;&lt;span class="o"&gt;(&lt;/span&gt;&lt;span class="n"&gt;x&lt;/span&gt;&lt;span class="o"&gt;){&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;	&lt;span class="n"&gt;f&lt;/span&gt; &lt;span class="o"&gt;=&lt;/span&gt; &lt;span class="mf"&gt;2.5f&lt;/span&gt;&lt;span class="o"&gt;;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="o"&gt;}&lt;/span&gt;&lt;span class="k"&gt;else&lt;/span&gt;&lt;span class="o"&gt;{&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;	&lt;span class="n"&gt;f&lt;/span&gt; &lt;span class="o"&gt;=&lt;/span&gt; &lt;span class="mf"&gt;3.1f&lt;/span&gt;&lt;span class="o"&gt;;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="o"&gt;}&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="k"&gt;return&lt;/span&gt; &lt;span class="n"&gt;f&lt;/span&gt;&lt;span class="o"&gt;;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;

&lt;div class="twocolumn-column"&gt;&lt;pre class="silq-code-window"&gt;&lt;code class="language-silq"&gt;// no initializer needed
if x {
	f := 2.5;
}else{
	f := 3.1;
